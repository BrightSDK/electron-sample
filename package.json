{
  "name": "electron-sample",
  "version": "1.0.0",
  "description": "Sample Electron application demonstrating the Bright Data SDK API",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "test": "mocha tests/*.test.js",
    "postinstall": "electron-rebuild"
  },
  "build": {
    "appId": "win_brightdata.electron_sample_app",
    "productName": "BRD SDK Sample App",
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      { "from": "brd_sdk_dist/lum_sdk64.dll",     "to": "." },
      { "from": "brd_sdk_dist/lum_sdk32.dll",     "to": "." },
      { "from": "brd_sdk_dist/net_updater32.exe", "to": "." },
      { "from": "brd_sdk_dist/brd_config.json",   "to": "." }
    ],
    "files": [
      "**/*",
      "!brd_sdk_dist/**"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "requestedExecutionLevel": "admin",
      "licenseFile": "build/LICENSE_BRIGHTDATA.txt",
      "include": "build/custom.nsh"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "brd-sdk": "github:BrightSDK/electron-plugin"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^29.0.0",
    "electron-builder": "^26.8.1",
    "mocha": "^11.0.0",
    "proxyquire": "^2.1.3"
  }
}
